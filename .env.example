# 每个入口默认使用 api、worker 或 sim；部署时可按进程覆盖。
# SERVICE_NAME=api
INSTANCE_ID=local-1
HTTP_ADDR=:8080
ADMIN_ADDR=:8081
SHUTDOWN_TIMEOUT=15s
LOG_LEVEL=info
AMQP_URL=amqp://metrics:metrics@localhost:5672/
AMQP_PUBLISHERS=1
AMQP_WRITE_TIMEOUT=5s
AMQP_CONFIRM_TIMEOUT=5s
AMQP_PUBLISH_MAX_ATTEMPTS=3
AMQP_PUBLISH_INITIAL_BACKOFF=100ms
AMQP_PUBLISH_MAX_BACKOFF=1s

# Docker Compose 本地依赖
POSTGRES_DB=metrics
POSTGRES_USER=metrics
POSTGRES_PASSWORD=metrics
POSTGRES_PORT=5432
RABBITMQ_DEFAULT_USER=metrics
RABBITMQ_DEFAULT_PASS=metrics
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
API_PORT=8080
API_ADMIN_PORT=8081
MIGRATION_TIMEOUT=60s
PARTITION_PAST_DAYS=8
PARTITION_FUTURE_DAYS=2
